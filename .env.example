# ============================================================================
# GitMaps — environment configuration
# Copy to `.env` (worker + API) and `.env.local` (Next.js web). Never commit.
# The web process reads only WEB_PORT / API_INTERNAL_URL; everything else is
# read by the worker and API.
# ============================================================================

# --- Application (required) ------------------------------------------------
# Supabase connection string. The API and worker connect with plain SQL
# (SQLAlchemy/asyncpg); migrations are applied via the Supabase CLI instead.
DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# GitHub API tokens — ONE key, multiple tokens, comma-separated. The worker
# treats them as a single shared rate-limit pool (architecture §6).
GITHUB_TOKENS=ghp_xxxxxxxxxxxxxxxx,ghp_yyyyyyyyyyyyyyyy

# Embedding model + dimension. Must match migration04's vector(n): changing
# the model is a NEW migration, and the app asserts EMBEDDING_DIMENSION equals
# the migration's dimension. all-MiniLM-L6-v2 (the compact class in
# architecture §7) emits384.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# --- Scheduling — worker job crons (optional; overrides in-code defaults) ---
# Job names per architecture §5. Unset any key to use its default.
SCHEDULE_DISCOVER="0 3 * * *"              # daily — discovery polling
SCHEDULE_SNAPSHOT_CORE="0 2 * * *"         # daily — 1-call core snapshots
SCHEDULE_SNAPSHOT_DEEP="30 2 * * 1"        # weekly (Mon) — contributors/commits
SCHEDULE_MOMENTUM="0 3 * * *"              # daily — after snapshots
SCHEDULE_SIGNIFICANCE="0 4 * * *"          # daily — promote fringe → surfaced
SCHEDULE_SEMANTIC_INCREMENTAL="0 5 * * *"  # daily — embed/anneal new nodes
SCHEDULE_SEMANTIC_FULL="0 6 * * 0"         # weekly (Sun) — full layout recompute

# --- Tunables (architecture §11: "gate/momentum tunables") -----------------
# Significance gate threshold — the multivariate bar for surfaced (ADR-0003).
SIGNIFICANCE_THRESHOLD=0.5

# Momentum per-signal weights (ADR-0002 transparency: decomposition is stored
# per signal; these weights must match what the breakdown reports).
MOMENTUM_SIGNAL_WEIGHTS={"stars":0.35,"forks":0.15,"watchers":0.10,"contributors":0.20,"commits":0.20}

# Rolling per-hour GitHub rate budget (architecture §6). The worker tracks the
# spent remainder in ingestion_state.
GITHUB_API_BUDGET_PER_HOUR=5000

# --- Web / API wiring (architecture §11) -----------------------------------
WEB_PORT=3000
API_PORT=8000
# Target of the Next.js /api rewrite → FastAPI. Keep on loopback behind the
# reverse proxy; never expose FastAPI directly.
API_INTERNAL_URL=http://127.0.0.1:8000

# ============================================================================
# Supabase CLI (deployment only — NOT read by the app). Needed for:
# supabase link && supabase db push
# ============================================================================
SUPABASE_PROJECT_REF=<project-ref>
SUPABASE_ACCESS_TOKEN=sbp_xxxxxxxxxxxxxxxx
SUPABASE_DB_PASSWORD=<db-password>
